# 复制为 .env。密钥与会话数据不会提交到 Git。
# 不预选模型供应商；请填写你已获得访问权限的 provider 和 model ID。
PA_PROVIDER=
PA_MODEL=
PA_API_KEY=

# 留空使用 Pi 内置供应商目录。
# 如使用 OpenAI Chat Completions 兼容服务，填 API 根地址（通常以 /v1 结尾）。
# 配置此项后，PA_PROVIDER 可取该服务的标识，PA_MODEL 使用服务实际提供的模型 ID。
PA_BASE_URL=

PA_DATA_DIR=.local/pa
# 自定义兼容服务的上下文窗口（必须对应真实模型，不用于扩展模型实际能力）。
PA_CONTEXT_WINDOW=32768
PA_MAX_OUTPUT_TOKENS=2048
PA_TIMEOUT_MS=60000

# QQ 官方群聊与私聊接入。凭证由 scripts/qq-bind.mjs 本地授权保存。
PA_QQ_APP_ID=
PA_QQ_APP_SECRET=
# 已验证测试群的 group_openid（不是 QQ 群号），逗号分隔。
PA_QQ_ALLOWED_GROUPS=
# 已验证私聊用户的 user_openid（不是 QQ 号码或群 member_openid），逗号分隔。
# 群与私聊白名单至少配置一个；未列入的私聊不保存、不调用模型、不回复。
PA_QQ_ALLOWED_USERS=
# 默认每次启动最多尝试 3 次，失败也计数；填 0 可不限次数持续运行。
PA_QQ_MAX_MODEL_CALLS=3

# 后台记忆独立于聊天计费。默认关闭，确认模型与预算后显式启用。
# 群50条/私聊50轮或最终上下文85%触发，复用上面的Pi模型。
PA_MEMORY_ENABLED=false
# 所有房间共用的每次启动请求上限，失败请求也计数，必须为正整数。
PA_MEMORY_MAX_CALLS=20
PA_MEMORY_TIMEOUT_MS=120000
PA_MEMORY_MAX_RETRIES=3
PA_MEMORY_MAX_OUTPUT_TOKENS=8192

# 可选：OpenAI-compatible embeddings 完整端点。
# 未配置时可提取Topic/更新画像/压缩，语义召回显示unavailable。
PA_EMBEDDING_URL=
PA_EMBEDDING_MODEL=
PA_EMBEDDING_API_KEY=
PA_EMBEDDING_DIMENSIONS=1024
PA_EMBEDDING_MAX_CALLS=100
