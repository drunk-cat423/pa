# 复制为 .env。密钥与会话数据不会提交到 Git。
# 不预选模型供应商；请填写你已获得访问权限的 provider 和 model ID。
PA_PROVIDER=
PA_MODEL=
PA_API_KEY=

# 留空使用 Pi 内置供应商目录。
# 如使用 OpenAI Chat Completions 兼容服务，填 API 根地址（通常以 /v1 结尾）。
# 配置此项后，PA_PROVIDER 可取该服务的标识，PA_MODEL 使用服务实际提供的模型 ID。
PA_BASE_URL=

PA_DATA_DIR=.local/pa
# 自定义兼容服务的上下文窗口（必须对应真实模型，不用于扩展模型实际能力）。
PA_CONTEXT_WINDOW=32768
PA_MAX_OUTPUT_TOKENS=2048
PA_TIMEOUT_MS=60000
# 同一渠道任务允许并行处理的最大数量（1 到 16）；不限制整个进程的总运行时长。
PA_MAX_CONCURRENT_TASKS=2
# 循环只限制调用次数；PA_TIMEOUT_MS限制单个模型请求。
PA_LOOP_MAX_MODEL_CALLS=6
PA_LOOP_MAX_TOOL_CALLS=8

# QQ 官方群聊与私聊接入。凭证由 scripts/qq-bind.mjs 本地授权保存。
PA_QQ_APP_ID=
PA_QQ_APP_SECRET=
# 已验证测试群的 group_openid（不是 QQ 群号），逗号分隔。
PA_QQ_ALLOWED_GROUPS=
# 已验证私聊用户的 user_openid（不是 QQ 号码或群 member_openid），逗号分隔。
# 群与私聊白名单至少配置一个；未列入的私聊不保存、不调用模型、不回复。
PA_QQ_ALLOWED_USERS=
# 沿用历史变量名，实际限制每次启动的问答任务数，默认3轮；失败也计数，0不限。
# 每轮至少准备/回答两个模型请求，请求数另受PA_LOOP_MAX_MODEL_CALLS限制。
PA_QQ_MAX_MODEL_CALLS=3

# 后台记忆独立于聊天计费。默认关闭，确认模型与预算后显式启用。
# 群聊与私聊仅在最终上下文达到实际窗口85%时触发压缩；复用Pi模型与continuationSummary。
# 画像/Topic另按新增内容计时：空闲10分钟或首条新增后30分钟，先到触发并同时清空计时。
PA_MEMORY_ENABLED=false
# 所有房间共用的每次启动请求上限，失败请求也计数；填0不限次数。
PA_MEMORY_MAX_CALLS=20
PA_MEMORY_TIMEOUT_MS=120000
PA_MEMORY_MAX_OUTPUT_TOKENS=8192

# DeepSeek 原生搜索：仅渠道当前消息明确要求搜索时可用；CLI及后台记忆不开工具。
# 复用 PA_API_KEY，官方端点固定。记录按 ID 持久化，失败也记录，重启不重置。
# PA_SEARCH_MAX_REQUESTS 与 PA_SEARCH_MAX_USES 填 0 表示不限；正整数可设置本地总请求上限和单次服务端搜索上限。
PA_SEARCH_ENABLED=false
PA_SEARCH_BUDGET_ID=
PA_SEARCH_MODEL=deepseek-flash
PA_SEARCH_MAX_REQUESTS=0
# 服务端搜索上限；usage计数可能包含拒绝调用，不能作为计费硬上限。
PA_SEARCH_MAX_USES=0
PA_SEARCH_MAX_TOKENS=2048
PA_SEARCH_TIMEOUT_MS=60000
PA_SEARCH_MAX_RESULTS=5

# 独立网页读取：当前用户直接贴链接或明确读取/打开链接时触发，不随搜索自动抓取。
PA_FETCH_ENABLED=false
# 本机TUN/Fake-IP环境可显式使用Cloudflare HTTPS公共DNS；只发送网页域名。
PA_FETCH_PUBLIC_DNS=false
# 仅 web_fetch 及其公共 DNS 查询使用此 HTTP 代理；QQ、模型和搜索 API 不受影响。
# 留空直连。只支持无认证的 HTTP 代理，例如服务器本机的 Mihomo。
PA_FETCH_PROXY_URL=
PA_FETCH_TIMEOUT_MS=15000
PA_FETCH_MAX_BYTES=1048576
# 每段正文的Unicode字符上限；完整正文仅缓存在当前任务内，可用游标续读。
PA_FETCH_MAX_CHARS=8000
