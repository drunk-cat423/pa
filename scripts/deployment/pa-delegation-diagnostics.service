[Unit]
Description=Prepare scoped PA service diagnostics for delegated tasks

[Service]
Type=oneshot
User=pa
SupplementaryGroups=systemd-journal
RuntimeDirectory=pa-delegation-diagnostics
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
ExecStart=/opt/node-v24.15.0/bin/node /opt/pa/current/scripts/deployment/delegation-diagnostics.mjs
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=96M
